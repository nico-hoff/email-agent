{
  "name": "@veryfront/ext-css-tailwind",
  "version": "0.1.1285",
  "description": "Veryfront first-party extension package for ext-css-tailwind",
  "keywords": [
    "veryfront",
    "extension",
    "ext-css-tailwind"
  ],
  "author": "Veryfront",
  "homepage": "https://github.com/veryfront/veryfront-code/tree/main/extensions/ext-css-tailwind",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/veryfront/veryfront-code.git",
    "directory": "extensions/ext-css-tailwind"
  },
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/veryfront/veryfront-code/issues"
  },
  "module": "./esm/src/index.js",
  "exports": {
    ".": {
      "import": "./esm/src/index.js",
      "types": "./esm/src/index.d.ts"
    }
  },
  "scripts": {},
  "engines": {
    "node": ">=22.3.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "veryfront": {
    "extension": true,
    "activation": "auto",
    "contracts": {
      "provides": [
        "CSSProcessor"
      ]
    },
    "npm": {
      "runtimeVersionFromManifest": true
    },
    "capabilities": [
      {
        "type": "fs:read"
      }
    ]
  },
  "dependencies": {
    "@tailwindcss/forms": "0.5.11",
    "daisyui": "5.5.14",
    "postcss-selector-parser": "7.1.6",
    "tailwind-scrollbar-hide": "2.0.0",
    "tailwindcss": "4.2.2",
    "tailwindcss-animate": "1.0.7",
    "tw-animate-css": "1.4.0"
  },
  "peerDependencies": {
    "veryfront": "^0.1.1285"
  },
  "type": "module",
  "types": "./esm/src/index.d.ts",
  "files": [
    "esm",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "gitHead": "2bac963100515224f14213021beb42e128b201ea"
}
