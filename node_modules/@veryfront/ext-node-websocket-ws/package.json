{
  "name": "@veryfront/ext-node-websocket-ws",
  "version": "0.1.1285",
  "description": "Veryfront first-party extension package for ext-node-websocket-ws",
  "keywords": [
    "veryfront",
    "extension",
    "ext-node-websocket-ws"
  ],
  "author": "Veryfront",
  "homepage": "https://github.com/veryfront/veryfront-code/tree/main/extensions/ext-node-websocket-ws",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/veryfront/veryfront-code.git",
    "directory": "extensions/ext-node-websocket-ws"
  },
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/veryfront/veryfront-code/issues"
  },
  "module": "./esm/index.js",
  "exports": {
    ".": {
      "import": "./esm/index.js",
      "types": "./esm/index.d.ts"
    }
  },
  "scripts": {},
  "engines": {
    "node": ">=22.3.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "veryfront": {
    "extension": true,
    "activation": "auto",
    "contracts": {
      "provides": [
        "NodeWebSocketServerProvider"
      ]
    },
    "capabilities": [
      {
        "type": "env:read",
        "keys": [
          "WS_NO_BUFFER_UTIL",
          "WS_NO_UTF_8_VALIDATE"
        ]
      }
    ]
  },
  "dependencies": {
    "@types/ws": "8.18.1",
    "ws": "8.21.1"
  },
  "peerDependencies": {
    "veryfront": "^0.1.1285"
  },
  "type": "module",
  "types": "./esm/index.d.ts",
  "files": [
    "esm",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "gitHead": "2bac963100515224f14213021beb42e128b201ea"
}
