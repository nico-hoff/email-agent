{
  "name": "email-agent",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "26.12.1"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local server.ts --development",
    "build": "veryfront build",
    "start": "node --env-file-if-exists=.env.local server.ts --production",
    "eval": "veryfront eval",
    "deploy": "veryfront deploy",
    "typecheck": "tsc --noEmit",
    "test": "node --test"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "dependencies": {
    "@openrouter/sdk": "^1.5.8",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "veryfront": "0.1.1285",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.9.0"
  }
}
