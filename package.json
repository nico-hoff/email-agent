{
  "name": "email-agent",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "26.12.1"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local server.ts --development",
    "build": "veryfront build",
    "start": "node --env-file-if-exists=.env.local server.ts --production",
    "eval": "veryfront eval",
    "sample": "node --env-file=.env.local scripts/sample.ts",
    "eval:jev": "node --env-file=.env.local scripts/eval-jev.ts --confirm-live",
    "eval:fetch": "node scripts/fetch-eval-datasets.ts",
    "eval:compare": "node scripts/compare-eval-runs.ts",
    "calibrate": "node --env-file-if-exists=.env.local scripts/calibrate.ts",
    "deploy": "veryfront deploy",
    "typecheck": "tsc --noEmit",
    "test": "node --test"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "dependencies": {
    "@openrouter/sdk": "^1.5.8",
    "@types/mailparser": "^3.9.0",
    "imapflow": "^2.9.1",
    "mailparser": "^3.12.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "veryfront": "0.1.1285",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.9.0"
  }
}
